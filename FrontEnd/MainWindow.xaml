<Window x:Class="MiSTerCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiSTerCast"
        mc:Ignorable="d"
        Title="MiSTerCast" Height="800" Width="700"
        Activated="Window_Activated"
        Closing="MainWindow_Closing"
        Closed="Window_Closed">
    <Border Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
                <!--<RowDefinition Height="*"/>-->
            </Grid.RowDefinitions>
            <GroupBox Header="Controls" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ToggleStreamButton" Grid.Column="0" Margin="10 10 10 10" IsEnabled="True" Height="Auto" Click="ToggleStreamButton_Click">Start Stream</Button>
                    <Button x:Name="SaveSettingsButton" Grid.Column="1" Margin="10 10 10 10" Click="SaveSettingsButton_Click">Save Settings</Button>
                    <Button x:Name="LoadSettingsButton" Grid.Column="2" Margin="10 10 10 10" Click="LoadSettingsButton_Click">Load Settings</Button>
                    <Label Grid.Column="3" Margin="10 10 10 10">Target</Label>
                    <TextBox x:Name="TargetIpAddresTextBox" Grid.Column="4" Margin="10 10 10 10" TextAlignment="Left">MiSTer</TextBox>
                    <Button x:Name="HelpButton" Grid.Column="5"  Margin="10 10 10 10" Click="HelpButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                        ?
                    </Button>
                </Grid>
            </GroupBox>
            <GroupBox Header="Stream" Grid.Row="1">
                <StackPanel>
                    <Grid Margin="10,1,10,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" ToolTip="LZ4 works on every Groovy core. NLC is near-lossless and holds 60fps where LZ4 cannot, but needs an NLC-capable core. Raw is for debugging only.">Codec</Label>
                            <ComboBox Grid.Row="1" x:Name="CodecComboBox" SelectedIndex="1" SelectionChanged="StreamOption_SelectionChanged"
                                      ToolTip="LZ4 works on every Groovy core. NLC is near-lossless and holds 60fps where LZ4 cannot, but needs an NLC-capable core. Raw is for debugging only.">
                                <ComboBoxItem>Raw (no compression)</ComboBoxItem>
                                <ComboBoxItem>LZ4</ComboBoxItem>
                                <ComboBoxItem>LZ4 + delta</ComboBoxItem>
                                <ComboBoxItem>LZ4HC</ComboBoxItem>
                                <ComboBoxItem>LZ4HC + delta</ComboBoxItem>
                                <ComboBoxItem>LZ4 adaptive</ComboBoxItem>
                                <ComboBoxItem>LZ4 adaptive + delta</ComboBoxItem>
                                <ComboBoxItem>NLC (near-lossless, needs updated core)</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Column="1" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0">RGB Mode</Label>
                            <ComboBox Grid.Row="1" x:Name="RgbModeComboBox" SelectedIndex="0" SelectionChanged="StreamOption_SelectionChanged">
                                <ComboBoxItem>RGB888</ComboBoxItem>
                                <ComboBoxItem>RGBA8888</ComboBoxItem>
                                <ComboBoxItem>RGB565</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Column="2" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0">MTU</Label>
                            <ComboBox Grid.Row="1" x:Name="MtuComboBox" SelectedIndex="0" SelectionChanged="StreamOption_SelectionChanged">
                                <ComboBoxItem>1500</ComboBoxItem>
                                <ComboBoxItem>3800 (needs Jumbo frames)</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Margin="10,1,10,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" ToolTip="Rice needs a Rice-capable Groovy core. An older core misparses Rice as TILED and shows garbage with no error.">NLC Pack</Label>
                            <ComboBox Grid.Row="1" x:Name="NlcPackComboBox" SelectedIndex="1" SelectionChanged="StreamOption_SelectionChanged"
                                      ToolTip="Rice needs a Rice-capable Groovy core (rbf_rice_r3 or newer). An older core misparses Rice bytes as TILED and shows garbage with no error.">
                                <ComboBoxItem>TILED</ComboBoxItem>
                                <ComboBoxItem>Rice (needs newer core)</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Column="1" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0">NLC NEAR</Label>
                            <ComboBox Grid.Row="1" x:Name="NearLevelComboBox" SelectedIndex="1" SelectionChanged="StreamOption_SelectionChanged">
                                <ComboBoxItem>0 (lossless)</ComboBoxItem>
                                <ComboBoxItem>1 (recommended)</ComboBoxItem>
                                <ComboBoxItem>2</ComboBoxItem>
                                <ComboBoxItem>3</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Column="2" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0">Log Level</Label>
                            <ComboBox Grid.Row="1" x:Name="LogLevelComboBox" SelectedIndex="0" SelectionChanged="StreamOption_SelectionChanged">
                                <ComboBoxItem>0 (errors)</ComboBoxItem>
                                <ComboBoxItem>1 (+ telemetry)</ComboBoxItem>
                                <ComboBoxItem>2 (full trace)</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Margin="20,4,20,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="AutoReconnectCheckBox" IsChecked="True" Checked="StreamOption_Checked" Unchecked="StreamOption_Checked"
                                  ToolTip="Rebuild the session automatically if the core restarts or the link drops.">Auto-reconnect</CheckBox>
                        <CheckBox Grid.Column="1" x:Name="AllowOversizeCheckBox" IsChecked="False" Checked="StreamOption_Checked" Unchecked="StreamOption_Checked"
                                  ToolTip="Permit modes larger than a fixed-frequency CRT should be asked to sync. The frame size limit still applies.">Allow oversize modes</CheckBox>
                    </Grid>
                    <TextBlock x:Name="ModelineWarningText" Margin="20,0,20,4" TextWrapping="Wrap" Foreground="#B00000" Visibility="Collapsed"/>
                </StackPanel>
            </GroupBox>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Modeline Presets" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="ModelinePresetsBox" Grid.Row="0" Margin="10 10 10 10" Width="Auto" SelectedIndex="0" SelectionChanged="ModelinePresetsBox_SelectionChanged">
                            <ComboBoxItem>320x240 NTSC (60Hz)</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="ApplyModelineButton" IsEnabled="False" Grid.Row="1" Margin="10 10 10 10" Click="ApplyModelineButton_Click">Apply Modeline</Button>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Modeline" Grid.Column="1">
                    <StackPanel>
                        <Grid Margin="10,1,10,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Pclock</Label>
                                <TextBox Grid.Row="1" x:Name="pclockTextBox" PreviewTextInput="PositiveDoubleValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="1" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Hactive</Label>
                                <TextBox Grid.Row="1" x:Name="hactiveTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="2" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Hbegin</Label>
                                <TextBox Grid.Row="1" x:Name="hbeginTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="3" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Hend</Label>
                                <TextBox Grid.Row="1" x:Name="hendTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="4" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Htotal</Label>
                                <TextBox Grid.Row="1" x:Name="htotalTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                        </Grid>
                        <Grid Margin="10,1,10,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Vactive</Label>
                                <TextBox Grid.Row="1" x:Name="vactiveTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="1" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Vbegin</Label>
                                <TextBox Grid.Row="1" x:Name="vbeginTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="2" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0">Vend</Label>
                                <TextBox Grid.Row="1" x:Name="vendTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="3" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" >Vtotal</Label>
                                <TextBox Grid.Row="1" x:Name="vtotalTextBox" PreviewTextInput="PositiveIntValidation" TextChanged="ModeLineTextBox_TextChanged"></TextBox>
                            </Grid>
                            <Grid Grid.Column="4" Margin="10,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" >Interlace</Label>
                                <CheckBox Grid.Row="4" HorizontalAlignment="Center" x:Name="interlacedCheckBox" Checked="InterlacedCheckBox_Checked" Unchecked="InterlacedCheckBox_Checked"></CheckBox>
                            </Grid>
                        </Grid>
                        <CheckBox x:Name="ProgressiveFramebufferCheckBox"
                                  Margin="20,4,10,6"
                                  IsChecked="False"
                                  IsEnabled="False"
                                  Checked="ProgressiveFramebufferCheckBox_Checked"
                                  Unchecked="ProgressiveFramebufferCheckBox_Checked"
                                  ToolTip="Send a full-height RGB framebuffer for interlaced modes. This may improve receiver stability but roughly doubles video bandwidth.">Full-height framebuffer (higher bandwidth)</CheckBox>
                    </StackPanel>
                </GroupBox>
            </Grid>
            <GroupBox Header="Capture Source" Grid.Row="3">
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="CaptureModeBox" Grid.Row="0" Margin="10 10 10 0" Width="Auto" SelectedIndex="0" SelectionChanged="CaptureMode_SelectionChanged"
                                  ToolTip="Capture a complete display or isolate one application window.">
                            <ComboBoxItem>Display</ComboBoxItem>
                            <ComboBoxItem>Window</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="CaptureSourceBox" Grid.Row="1" Margin="10 10 10 0" Width="Auto" SelectedIndex="0" SelectionChanged="CaptureSource_SelectionChanged">
                            <ComboBoxItem>Display 1</ComboBoxItem>
                            <ComboBoxItem>Display 2</ComboBoxItem>
                            <ComboBoxItem>Display 3</ComboBoxItem>
                            <ComboBoxItem>Display 4</ComboBoxItem>
                        </ComboBox>
                        <Grid x:Name="WindowSourcePanel" Grid.Row="1" Margin="10 10 10 0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowSourceBox" Grid.Column="0" MinWidth="150" SelectionChanged="WindowSource_SelectionChanged"
                                      ToolTip="Visible application windows. Minimized windows pause capture until restored."/>
                            <Button x:Name="RefreshWindowsButton" Grid.Column="1" Margin="4 0 0 0" Padding="6 0" Click="RefreshWindowsButton_Click"
                                    ToolTip="Refresh the window list">↻</Button>
                        </Grid>
                        <ComboBox x:Name="AlignmentBox" Grid.Row="2" Margin="10 10 10 0" Width="Auto" SelectedIndex="0" SelectionChanged="CaptureSource_SelectionChanged">
                            <ComboBoxItem>Centered</ComboBoxItem>
                            <ComboBoxItem>TopLeft</ComboBoxItem>
                            <ComboBoxItem>Top</ComboBoxItem>
                            <ComboBoxItem>TopRight</ComboBoxItem>
                            <ComboBoxItem>Right</ComboBoxItem>
                            <ComboBoxItem>BottomRight</ComboBoxItem>
                            <ComboBoxItem>Bottom</ComboBoxItem>
                            <ComboBoxItem>BottomLeft</ComboBoxItem>
                            <ComboBoxItem>Left</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="RotateComboBox" Grid.Row="3" Margin="10 10 10 0" Width="Auto" SelectedIndex="0" SelectionChanged="CaptureSource_SelectionChanged">
                            <ComboBoxItem>No Rotate</ComboBoxItem>
                            <ComboBoxItem>90° CCW</ComboBoxItem>
                            <ComboBoxItem>90° CW</ComboBoxItem>
                            <ComboBoxItem>180°</ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="EnableAudioCheckBox" Grid.Row="4" Margin="10 10 10 0" IsChecked="True" Checked="CaptureSource_Checked" Unchecked="CaptureSource_Checked">Enable Audio</CheckBox>
                        <CheckBox x:Name="EnablePreviewCheckBox" Grid.Row="5" Margin="10 10 10 0" IsChecked="True" Checked="CaptureSource_Checked" Unchecked="CaptureSource_Checked">Enable Preview</CheckBox>
                    </Grid>
                    <Grid Grid.Column="1" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="CropComboBox" Grid.Row="0" Margin="10 10 10 0" Width="Auto" SelectedIndex="0" SelectionChanged="CaptureSource_SelectionChanged">
                            <ComboBoxItem>Custom Size</ComboBoxItem>
                            <ComboBoxItem>1X Crop</ComboBoxItem>
                            <ComboBoxItem>2X Crop</ComboBoxItem>
                            <ComboBoxItem>3X Crop</ComboBoxItem>
                            <ComboBoxItem>4X Crop</ComboBoxItem>
                            <ComboBoxItem>5X Crop</ComboBoxItem>
                            <ComboBoxItem>Full 4:3 Crop</ComboBoxItem>
                            <ComboBoxItem>Full 5:4 Crop</ComboBoxItem>
                            <ComboBoxItem>Full Source</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="SamplingComboBox"
                                  Grid.Row="1"
                                  Margin="10 10 10 0"
                                  Width="Auto"
                                  SelectedIndex="0"
                                  SelectionChanged="CaptureSource_SelectionChanged"
                                  ToolTip="Point is pixel-exact. Bilinear smooths neighboring pixels. Line Blend applies an area-weighted vertical filter to reduce CRT line shimmer.">
                            <ComboBoxItem>Point</ComboBoxItem>
                            <ComboBoxItem>Bilinear</ComboBoxItem>
                            <ComboBoxItem>Line Blend</ComboBoxItem>
                        </ComboBox>
                        <Grid Grid.Row="2" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="10 10 10 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Size</Label>
                                <TextBox x:Name="CaptureWidth" Grid.Column="1" Margin="4,4,4,4" PreviewTextInput="PositiveIntValidation" TextChanged="CaptureSource_TextChanged">320</TextBox>
                                <TextBox x:Name="CaptureHeight" Grid.Column="2" Margin="4,4,4,4" PreviewTextInput="PositiveIntValidation" TextChanged="CaptureSource_TextChanged">240</TextBox>
                            </Grid>
                            <Grid Grid.Row="1" Margin="10 0 10 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">Offset</Label>
                                <TextBox x:Name="CaptureXOffset" Grid.Column="1" Margin="4,4,4,4" PreviewTextInput="IntValidation" TextChanged="CaptureSource_TextChanged">0</TextBox>
                                <TextBox x:Name="CaptureYOffset" Grid.Column="2" Margin="4,4,4,4" PreviewTextInput="IntValidation" TextChanged="CaptureSource_TextChanged">0</TextBox>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="2" Background="Gray">
                        <Label x:Name="PreviewDisabledLabel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">Preview Disabled</Label>
                        <Image x:Name="PreviewImage" Margin="1,1,1,1"></Image>
                    </Grid>
                </Grid>
            </GroupBox>
            <GroupBox Header="Logs" Margin="0 0 0 10" Grid.Row="4">
                <ScrollViewer x:Name="LogScrollView" Margin="0,0,10,0" ScrollChanged="LogScrollView_ScrollChanged" >
                    <StackPanel x:Name="LogPanel">
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Border>
</Window>
